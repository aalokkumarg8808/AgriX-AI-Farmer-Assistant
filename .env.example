# AgriX AI configuration template. Never put real API keys in this file.
# Public/client APKs must call an HTTPS backend proxy that holds GEMINI_API_KEY server-side.
# The app intentionally has no direct-client Gemini API-key fallback.
AI_BACKEND_BASE_URL=https://your-agrix-ai-proxy.example.com/
GEMINI_API_KEY=NONE
