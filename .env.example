# AgriX AI Environment Secrets Template
# Copy this file to `.env` (which is git-ignored) for local development, or configure secrets in your CI / AI Studio Secrets panel.
#
# SECURITY WARNING:
# Any secret injected into Android `BuildConfig` or packaged in an APK is extractable from the binary.
# For production releases, set `AI_BACKEND_BASE_URL` to your backend proxy server (which holds GEMINI_API_KEY
# securely in server-side environment variables) and leave `GEMINI_API_KEY` as a placeholder.
# Note: Do not leave keys completely empty (e.g. `KEY=`) as the Android Secrets Gradle Plugin requires a non-empty token.
AI_BACKEND_BASE_URL=NONE

# Direct client fallback key (for local development / testing only when AI_BACKEND_BASE_URL is NONE):
GEMINI_API_KEY=MY_GEMINI_API_KEY
